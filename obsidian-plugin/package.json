{
  "name": "local-typelit-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin version of Local TypeLit",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "install-to-vault": "node scripts/install-to-vault.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.8.0"
  }
}
